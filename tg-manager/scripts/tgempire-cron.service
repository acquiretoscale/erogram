# systemd unit — install with scripts/vps-install.sh
# Polls /api/cron/post every 60s so scheduled posts fire within the ±15 min window.

[Unit]
Description=TGempire post scheduler (local cron loop)
After=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__APP_DIR__
Environment=TG_CRON_URL=http://127.0.0.1:3942/api/cron/post
Environment=TG_CRON_LOG=/var/log/tgempire-cron.log
ExecStart=__APP_DIR__/scripts/local-cron.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
