{
  "redirects": [
    {
      "has": [{ "type": "host", "value": "erogram.pro" }],
      "source": "/(.*)",
      "destination": "https://erogramx.com/$1",
      "permanent": true
    },
    {
      "has": [{ "type": "host", "value": "www.erogram.pro" }],
      "source": "/(.*)",
      "destination": "https://erogramx.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/premium-stories",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/premium-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/reconcile-crypto",
      "schedule": "0 * * * *"
    }
  ]
}
